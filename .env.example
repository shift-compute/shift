# ---------------------------------------------------------------------------
# App configuration (validated at startup by packages/core/src/config.ts).
# The process does not start if a required variable is missing or invalid.
# ---------------------------------------------------------------------------

# Web + worker
DATABASE_URL=postgresql://user:password@localhost:5432/shift
# 32 random bytes in base64: `openssl rand -base64 32`. Encrypts the users' mk- keys at rest.
SHIFT_MASTER_KEY=
# Web only: 32+ random characters for the session cookie
SESSION_SECRET=
PUBLIC_APP_URL=http://localhost:3000
UPLOAD_DIR=./uploads

# 0G Router. Mainnet: https://router-api.0g.ai/v1 — Testnet: https://router-api-testnet.integratenetwork.work/v1
ZG_ROUTER_BASE_URL=https://router-api.0g.ai/v1

# Chain, storage and contracts. The hackathon build runs on the 0G Galileo testnet (chain ID 16602).
# Mainnet equivalents: chain ID 16661, RPC https://evmrpc.0g.ai, indexer https://indexer-storage-turbo.0g.ai, explorer https://chainscan.0g.ai
ZG_CHAIN_ID=16602
ZG_CHAIN_RPC_URL=https://evmrpc-testnet.0g.ai
ZG_STORAGE_INDEXER_URL=https://indexer-storage-testnet-turbo.0g.ai
ZG_EXPLORER_URL=https://chainscan-galileo.0g.ai
# ShiftLedger on Galileo (PROGRESS.md F0.6). anchorNight sends here; it does not deploy a new contract.
LEDGER_CONTRACT_ADDRESS=0xA3B6664b487FC01c4264977c9B92058A89C31Ed7

# Web + worker. A manual run uploads outputs with the same storage client as the nightly worker.
# The validated web config object does not include this key; only POST /api/runs/now reads it, and it never reaches the browser.
# Dedicated operator wallet (never a personal one). Testnet faucet: https://faucet.0g.ai
OPERATOR_PRIVATE_KEY=0x...
# Shared by the nightly worker and "run now"
NIGHT_HARD_STOP_UTC=23:50
SAFETY_MARGIN_PCT=10
MAX_CONCURRENCY=3

# Worker only
NIGHT_START_UTC=23:00
COMMONS_GATE_THRESHOLD=0.75

# ---------------------------------------------------------------------------
# Phase 0 scripts (pnpm smoke, pnpm storage-check)
# ---------------------------------------------------------------------------

# Management key of the TEAM account for Phase 0.
# pc.0g.ai → Settings → Management Keys → Custom: account:read, keys:create, keys:manage
ZG_MK_KEY=mk-...

# Trust level for the checks: private | verified | standard
SMOKE_TRUST_MODE=private

# Optional: force models (IDs are listed in docs/spike/models.json after the first run)
SMOKE_CHAT_MODEL=
SMOKE_DECISION_MODEL=

# Per-key limit field and value (from `pnpm inspect-openapi`): `credit_limit`, a string in 0G units
SMOKE_KEY_LIMIT_FIELD=credit_limit
SMOKE_KEY_LIMIT_VALUE=0.01

# Optional checks (cost a bit more)
SMOKE_IMAGE=0
SMOKE_AUDIO_FILE=
