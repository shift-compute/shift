# 0G Router (mainnet). Testnet: https://router-api-testnet.integratenetwork.work/v1
ZG_ROUTER_BASE_URL=https://router-api.0g.ai/v1

# Llave de gestión de la cuenta del EQUIPO para la Fase 0.
# pc.0g.ai → Settings → Management Keys → Custom: account:read, keys:create, keys:manage
ZG_MK_KEY=mk-...

# Nivel de confianza para las pruebas: private | verified | standard
SMOKE_TRUST_MODE=private

# Opcionales: forzar modelos (los IDs salen de docs/spike/models.json tras la primera corrida)
SMOKE_CHAT_MODEL=
SMOKE_DECISION_MODEL=

# Rellenar tras `npm run inspect-openapi`: nombre real del campo de límite por llave y valor
SMOKE_KEY_LIMIT_FIELD=
SMOKE_KEY_LIMIT_VALUE=

# Pruebas opcionales (cuestan un poco más)
SMOKE_IMAGE=0
SMOKE_AUDIO_FILE=

# Contratos (Foundry)
ZG_CHAIN_RPC_URL=https://evmrpc.0g.ai
OPERATOR_PRIVATE_KEY=0x...
