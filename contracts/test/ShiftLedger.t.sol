pragma solidity ^0.8.24;

import {Test} from "forge-std/Test.sol";
import {Ownable} from "@openzeppelin/contracts/access/Ownable.sol";
import {ShiftLedger} from "../src/ShiftLedger.sol";

/// Vector generated by scripts/merkle-vector.ts (OpenZeppelin StandardMerkleTree, TypeScript).
contract ShiftLedgerTest is Test {
    ShiftLedger ledger;
    address operator = address(0xA11CE);
    uint64 constant NIGHT = 20261107;

    bytes32 constant ROOT = 0xf2886163a1a52848ca79761fae2dd697241212a0b8cabf850a20081ab985ec4c;
    bytes32 constant LEAF0 = 0x7c4c1f4f6cb7969b54cea93af5d1365e69183245974064d8b40a8068b70f2ede;
    bytes32 constant LEAF1 = 0xd6092256f51b7a5c850a9e7511c220748c3b611a490c51029773d9d46e369243;

    function setUp() public {
        ledger = new ShiftLedger(operator);
    }

    function test_LeafHashParityWithTypeScript() public view {
        bytes32 h0 = ledger.leafHash(
            0x96a5c1060e037d5b27f6664b0627d6c5b1d27611e214cf521788d911c462fd1c,
            0x1111111111111111111111111111111111111111,
            0xa48d4955fc8d2b9b4db01452af27d26bd30ca536fabafe34b0aeac4d32942f4f,
            0xabababababababababababababababababababababababababababababababab,
            0x7175d6bb67d912381a134ba7761f7e12ec4fa487021956dcfce14807718d07a9,
            2, 1234, false
        );
        bytes32 h1 = ledger.leafHash(
            0xceba588ab2e9420b67eb45fa23dac3f39bcf0cce5384fa769bbdbe3f578c56ef,
            0x2222222222222222222222222222222222222222,
            0x1737a731f8c125ac103387d4744314bf5abedc135bb5e1e7bd5c94be102e3469,
            0xcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcd,
            0x1125a5e4cc6d2592878c0498f3e69b293bc43718b5b92377c10c1f3defb7d1ba,
            2, 5678, true
        );
        assertEq(h0, LEAF0, "leaf0 TS/Solidity mismatch");
        assertEq(h1, LEAF1, "leaf1 TS/Solidity mismatch");
    }

    function test_AnchorAndVerify() public {
        vm.prank(operator);
        ledger.anchorNight(NIGHT, ROOT, bytes32(uint256(1)), 2);

        bytes32[] memory proof0 = new bytes32[](1);
        proof0[0] = LEAF1;
        bytes32[] memory proof1 = new bytes32[](1);
        proof1[0] = LEAF0;

        assertTrue(ledger.verifyLeaf(NIGHT, proof0, LEAF0));
        assertTrue(ledger.verifyLeaf(NIGHT, proof1, LEAF1));
        assertFalse(ledger.verifyLeaf(NIGHT, proof0, LEAF1));
        assertFalse(ledger.verifyLeaf(NIGHT + 1, proof0, LEAF0)); // not anchored
    }

    function test_OnlyOwnerCanAnchor() public {
        vm.expectRevert(abi.encodeWithSelector(Ownable.OwnableUnauthorizedAccount.selector, address(this)));
        ledger.anchorNight(NIGHT, ROOT, bytes32(0), 2);
    }

    function test_CannotAnchorTwice() public {
        vm.startPrank(operator);
        ledger.anchorNight(NIGHT, ROOT, bytes32(0), 2);
        vm.expectRevert(abi.encodeWithSelector(ShiftLedger.AlreadyAnchored.selector, NIGHT));
        ledger.anchorNight(NIGHT, ROOT, bytes32(0), 2);
        vm.stopPrank();
    }

    function test_RejectsEmptyRoot() public {
        vm.prank(operator);
        vm.expectRevert(ShiftLedger.EmptyRoot.selector);
        ledger.anchorNight(NIGHT, bytes32(0), bytes32(0), 0);
    }

    function test_Donations() public {
        address[] memory donors = new address[](2);
        donors[0] = address(0x1111111111111111111111111111111111111111);
        donors[1] = address(0x2222222222222222222222222222222222222222);
        uint64[] memory amounts = new uint64[](2);
        amounts[0] = 1000;
        amounts[1] = 2500;

        vm.startPrank(operator);
        vm.expectRevert(abi.encodeWithSelector(ShiftLedger.NotAnchored.selector, NIGHT));
        ledger.recordDonations(NIGHT, donors, amounts);

        ledger.anchorNight(NIGHT, ROOT, bytes32(0), 2);
        ledger.recordDonations(NIGHT, donors, amounts);
        assertEq(ledger.donatedUsdMicro(NIGHT, donors[1]), 2500);
        assertEq(ledger.totalDonatedUsdMicro(donors[0]), 1000);

        vm.expectRevert(abi.encodeWithSelector(ShiftLedger.DonationsAlreadyRecorded.selector, NIGHT));
        ledger.recordDonations(NIGHT, donors, amounts);
        vm.stopPrank();
    }

    function test_LengthMismatch() public {
        address[] memory donors = new address[](1);
        uint64[] memory amounts = new uint64[](2);
        vm.startPrank(operator);
        ledger.anchorNight(NIGHT, ROOT, bytes32(0), 2);
        vm.expectRevert(ShiftLedger.LengthMismatch.selector);
        ledger.recordDonations(NIGHT, donors, amounts);
        vm.stopPrank();
    }
}
