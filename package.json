{
  "name": "shift",
  "version": "0.1.0",
  "description": "Shift — turns expiring 0G compute credits into useful, verifiable work",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "smoke": "tsx scripts/smoke.ts",
    "inspect-openapi": "tsx scripts/inspect-openapi.ts",
    "merkle-vector": "tsx scripts/merkle-vector.ts",
    "storage-check": "tsx scripts/storage-check.ts",
    "gen:router-types": "tsx scripts/gen-router-types.ts",
    "build": "pnpm -r --if-present build",
    "typecheck": "tsc -p tsconfig.json && pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:contracts": "cd contracts && forge test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:validate": "prisma validate",
    "dev": "pnpm --filter @shift/web dev",
    "postinstall": "prisma generate"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "openapi-typescript": "^7.13.0",
    "prisma": "7.10.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "@0gfoundation/0g-ts-sdk": "^1.2.8",
    "@openzeppelin/contracts": "^5.1.0",
    "@openzeppelin/merkle-tree": "^1.0.7",
    "@prisma/client": "^7.10.1",
    "ethers": "^6.13.1",
    "solc": "^0.8.24",
    "yaml": "^2.6.0"
  }
}
